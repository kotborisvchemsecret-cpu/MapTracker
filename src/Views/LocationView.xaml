<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MapTracker.ViewModels"
             xmlns:models="clr-namespace:MapTracker.Models"
             x:Class="MapTracker.Views.LocationView">

    <ContentPage.BindingContext>
        <vm:LocationViewModel/>
    </ContentPage.BindingContext>


    <Grid
        RowDefinitions = "*,*,2*">

        <Label
            Text="{Binding CurrLatitude}"
            TextColor="White"
            Grid.Row="0"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>
        
        <Label
            Text="{Binding CurrLongitude}"
            TextColor="White"
            Grid.Row="1"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>

        <Button
            Text="Get Location"
            Command="{Binding GetCurrentLocationCommand}"
            Grid.Row="2"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>

    </Grid>
</ContentPage>
