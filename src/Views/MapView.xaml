<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MapTracker.Models"
             x:Class="MapTracker.Views.MapView"
             Title="MapView">
    <Grid>
        <controls:CustomMap 
             RoutePath="{Binding Route.Path}"
            CurrentPosition="{Binding CurrentPosition}"
            IsShowingUser="True"
            MapType="Street" />
    </Grid>
    
</ContentPage>